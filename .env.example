VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Agent connector (/api/mcp), server-side only: set these on Vercel, not here.
# MCP_API_KEY=a-long-random-key
# MCP_USER_EMAIL=your-planner-login-email
# MCP_USER_PASSWORD=your-planner-password

# USCF ratings (/api/uscf), server-side only, and optional. The function reads
# the US Chess ratings API directly; this is a backup route through a scraping
# service for when that API, or the old member pages, turn server requests away.
# Set on Vercel as a URL template with {url} where the page address goes, e.g.
# USCF_FETCH_URL=https://app.scrapingbee.com/api/v1/?api_key=YOUR_KEY&render_js=true&premium_proxy=true&url={url}
# USCF_FETCH_URL=https://api.scraperapi.com/?api_key=YOUR_KEY&render=true&premium=true&url={url}
